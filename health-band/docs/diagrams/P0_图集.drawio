<mxCell id="21" value="补充规则：有效活动 = 5 min 窗口内 ≥30 步 或 中等以上强度（排除拿水杯/打字/抖腿）；站起接电话给 2 min 宽限期防规避；提醒弹窗为覆盖层，未处理不许切页。" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="720" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hf6bp6do-x4ad" name="页面原型草图"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="图 3  页面原型草图（4 个必做页线框 + 主流程）" style="text;fontSize=16;fontStyle=1;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="8" width="470" height="26" as="geometry"/></mxCell>

<mxCell id="35" value="&lt;b&gt;该起身了&lt;/b&gt;&lt;br&gt;&lt;br&gt;马达 2s×3&lt;br&gt;全屏遮罩 60% 黑&lt;br&gt;&lt;br&gt;[ 已起身 ]&lt;br&gt;[ 稍后 10 min ]" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontColor=#7c5800;spacingLeft=4;whiteSpace=wrap;html=1;" vertex="1" parent="30"><mxGeometry x="175" y="78" width="150" height="100" as="geometry"/></mxCell>

<mxCell id="54" value="短按切页" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#e11d48;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#be123c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="51" target="52"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="55" value="弹窗处理后" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#e11d48;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#be123c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="52" target="53"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="iiepiuty-l5b8" name="五链路草图"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="图 4  五链路草图 — 运动 → 判定 → 提醒 → 记录 → 同步" style="text;fontSize=16;fontStyle=1;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="160" y="8" width="510" height="26" as="geometry"/></mxCell>
<mxCell id="10" value="① 运动&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;IMU 50 Hz 采样&lt;br&gt;零偏校准 + 低通&lt;br&gt;ImuFrame 入队（值传递）&lt;br&gt;丢样率 &lt; 0.1%&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#3d6a99;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#1e3a5f;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="145" height="115" as="geometry"/></mxCell>
<mxCell id="11" value="② 判定&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;StepService 动态阈值/峰谷对&lt;br&gt;→ 步事件、活动强度&lt;br&gt;SedentaryService 久坐状态机&lt;br&gt;佩戴中 + 非免打扰 + 45 min&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#3d6a99;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#1e3a5f;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="215" y="55" width="170" height="115" as="geometry"/></mxCell>
<mxCell id="12" value="③ 提醒&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;马达 2 s×3 + 全屏弹窗&lt;br&gt;已起身 / 稍后 10 min&lt;br&gt;60 s 无操作自动稍后&lt;br&gt;走 30 步复位&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#3d6a99;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#1e3a5f;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="55" width="155" height="115" as="geometry"/></mxCell>
<mxCell id="13" value="④ 记录&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;UI 1 s 节流刷新&lt;br&gt;RecordStore 每分钟聚合&lt;br&gt;16 字节写 LittleFS&lt;br&gt;环形缓冲 ≥ 7 天 + NVS 游标&lt;/font&gt;" style="rounded=1;fillColor=#e1f5e9;strokeColor=#2f9e5f;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#065f46;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="55" width="160" height="115" as="geometry"/></mxCell>
<mxCell id="14" value="⑤ 同步（选做）&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;每 5 min 连 Wi-Fi → AUTH&lt;br&gt;按游标 SYNC 分批补传&lt;br&gt;ACK → 更新游标 → 关 Wi-Fi&lt;br&gt;(device_id, ts) 幂等去重&lt;/font&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#7c5800;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="215" width="160" height="115" as="geometry"/></mxCell>
<mxCell id="15" value="PC 端只读归档（选做）&lt;br&gt;SQLite WAL / 查询 / 曲线 / CSV" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#7c5800;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="375" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="20" value="步事件 / 活动强度" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#1e3a5f;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="21" value="触发条件满足" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#1e3a5f;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="22" value="状态 + 聚合数据" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#1e3a5f;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="23" value="联网时按游标" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#1e3a5f;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="24" value="历史记录" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#1e3a5f;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="30" value="三要点：① 采集与算法分离（队列削峰）　② 跨任务传值不传指针　③ UI 必须节流（1 s 刷新，保证 ≥ 25 fps）" style="text;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#475569;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="720" height="20" as="geometry"/></mxCell>
<mxCell id="31" value="关键设计：判定 / 提醒 / 记录全在终端本地 → 断网、无手机、无 App 时久坐提醒照样工作（回应「信号差 / 提醒延迟 / 平台互通不便」）。" style="rounded=1;fillColor=#e1f5e9;strokeColor=#2f9e5f;fontSize=11;align=left;verticalAlign=middle;fontColor=#065f46;spacingLeft=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="530" height="48" as="geometry"/></mxCell>
<mxCell id="32" value="失败处理：&lt;br&gt;• 摘腕 → WearOff 停止计时并保存&lt;br&gt;• 22:00–07:00 → Quiet 暂停提醒仅计时&lt;br&gt;• 断网 → 本地环形缓冲 ≥7 天，恢复后补传&lt;br&gt;• 写入中掉电 → 文件可读、游标不超前&lt;br&gt;• ACK 丢失重发旧批次 → 幂等去重" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;fontColor=#7c5800;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="530" height="125" as="geometry"/></mxCell>
<mxCell id="33" value="采样率取舍：25 / 50 / 100 Hz 实测对比，取 50 Hz —— 覆盖 0.5–5 Hz 步态主频且 CPU 不过载。分级采样：IMU 50 Hz / PPG 按需 100 Hz / 温度 1 Hz（回应「采样频率与功耗矛盾」）。" style="text;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#475569;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="720" height="40" as="geometry"/></mxCell>
<mxCell id="34" value="选做链路（虚线/黄色）不参与实时判定，服务端只做异步归档；必做链路（蓝/绿）对外部生态依赖为 0。新增选做链路 ⑥ 健康问答（PC 大模型 + 基于 PC 端数据的 RAG）与 ⑦ 手环操控鼠标（BLE HID）见「选做扩展链路」页。" style="text;fillColor=none;strokeColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#475569;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="720" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="opt-features" name="选做扩展链路"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="图 5  选做扩展链路 — PC 大模型健康问答 / RAG 检索 / 手环操控鼠标（均为选做，挂在只读归档之后）" style="text;fontSize=15;fontStyle=1;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="760" height="26" as="geometry"/></mxCell>
<mxCell id="10" value="前置（选做）&lt;br&gt;⑤ 同步补传 + PC 端只读归档&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;SQLite WAL · records / events / sync_state&lt;br&gt;按 (device_id, ts) 幂等&lt;/font&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#7c5800;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="11" value="FR-20 RAG 检索（选做）&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;语料＝PC 端已归档数据&lt;br&gt;切片 → 本地索引 → Top-K&lt;br&gt;来源可追溯到 (device_id, ts)&lt;/font&gt;" style="rounded=1;fillColor=#e1d5f7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#4c2a6b;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="55" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="12" value="FR-19 本地大模型（选做）&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;问题 + 检索片段 → Prompt&lt;br&gt;本地/局域网推理，不出公网&lt;br&gt;模型选型（待补充）&lt;/font&gt;" style="rounded=1;fillColor=#e1d5f7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#4c2a6b;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="55" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="13" value="健康问答回答&lt;br&gt;+ 检索来源卡 +「教学演示，非医疗建议」" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="20" value="归档数据" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7c5800;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="21" value="Top-K 片段" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7c5800;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="22" value="回答 + 来源" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#4c2a6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="30" value="FR-21 手环操控鼠标（选做·独立链路）&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;IMU 手势 / 按键 → BLE HID 或自定义协议 → PC 端驱动 → 鼠标移动 / 点击&lt;br&gt;默认关闭 · 开启需二次确认 · PC 端一键断开 · 超时自动断开 · 不影响计步与久坐提醒&lt;/font&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#7c4700;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="710" height="95" as="geometry"/></mxCell>
<mxCell id="31" value="依赖关系：FR-14/15（同步 + PC 端） → FR-20（RAG 索引） → FR-19（健康问答）；FR-21 与其余独立。三项均为 P2 加分选做，裁剪任一不影响必做闭环与四条底线。" style="rounded=1;fillColor=#e1f5e9;strokeColor=#2f9e5f;fontSize=11;align=left;verticalAlign=middle;fontColor=#065f46;spacingLeft=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="710" height="50" as="geometry"/></mxCell>
<mxCell id="32" value="边界（NFR-11/12）：模型与检索全程局域网/本机，不上传真实身份、不作医疗诊断；回答必须附来源，无归档数据时提示「暂无可检索数据」不编造；鼠标映射不自研驱动内核。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#7c5800;spacingLeft=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="710" height="50" as="geometry"/></mxCell>
<mxCell id="33" value="对应：SRS §3.4 ⑥⑦ / §5.2 FR-19~21 / §6 NFR-11~12 / §7 UC-09~11；RTM T-15~17；界面说明书 UI-PC-02 / UI-PC-03。" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="710" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxCell id="45" value="屏幕亮度 [ 70% ]　　同步开关 [ 可关闭 ]" style="rounded=1;fillColor=#ffffff;strokeColor=#c3d2e6;fontSize=10;align=left;verticalAlign=middle;fontColor=#334155;spacingLeft=8;whiteSpace=wrap;html=1;" vertex="1" parent="40"><mxGeometry x="20" y="150" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="46" value="保存（NVS）" style="rounded=1;fillColor=#2dd4bf;strokeColor=#0f766e;fontSize=11;fontStyle=1;fontColor=#042f2e;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="40"><mxGeometry x="115" y="182" width="110" height="28" as="geometry"/></mxCell>
<mxCell id="50" value="主流程（P0 验收 A-02）｜选做页（心率血氧 / 体温）显示「未启用」而非留白｜可点击区 ≥48×48 px" style="text;fontSize=10;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#be123c;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="720" height="18" as="geometry"/></mxCell>
<mxCell id="51" value="① 看步数&lt;br&gt;表盘 / 运动页（UC-01）" style="rounded=1;fillColor=#e1f5e9;strokeColor=#2f9e5f;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#065f46;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="200" height="56" as="geometry"/></mxCell>
<mxCell id="52" value="② 被提醒&lt;br&gt;久坐页 + 提醒弹窗（UC-02）" style="rounded=1;fillColor=#e1f5e9;strokeColor=#2f9e5f;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#065f46;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="522" width="200" height="56" as="geometry"/></mxCell>

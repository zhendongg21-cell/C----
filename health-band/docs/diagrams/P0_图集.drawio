<mxCell id="15" value="⑥ 「已起身」或 5 min 内 ≥30 步 → 清零、记录一次提醒" style="edgeStyle=none;endArrow=block;strokeColor=#2f9e5f;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0;exitY=0.15;entryX=1;entryY=0.9;html=1;" edge="1" parent="1" source="7" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
